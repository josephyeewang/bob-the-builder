{
  "_about": "Shell-trick cases for the production guard (R-0b-70). {{P}} is replaced by every path form in runner.mjs (pathForms), so each template runs once per form; with a cwd, also in its absolute form. 'refuse_folder' reads or writes the whole folder ({{DIR}}). 'refuse_cd_up' is asked from the file's folder and steps up ({{UP}} is that folder's name). 'allow_elsewhere' is asked from the folder above and the file's folder. In 'refuse_after_cd', {{DIR}} is the protected file's folder and {{BASE}} its short name in every form. 'dead' lists the template and form pairs that no shell turns into a touch of the file (left out; selfcheck.mjs and a test keep the list exact). 'allow_near' are safe commands built from the file's folder ({{DIR}}) and each word of its name ({{WORD}}). Every 'refuse' case must be refused; every 'allow' case must be allowed, so a guard that refuses everything also fails. Cases written for Bob, not copied from another project. Both sides are samples: passing them does not prove a guard protects the file in every way, or never refuses too much.",
  "refuse": {
    "write": [
      "echo x > {{P}}",
      "printf 'x' >> {{P}}",
      "echo x | tee {{P}}",
      "cp /tmp/x {{P}}",
      "mv /tmp/x {{P}}",
      "sed -i.bak 's/^/x/' {{P}}",
      "dd if=/tmp/x of={{P}}",
      "truncate -s 0 {{P}}",
      "rm -f {{P}}",
      "ln -sf /tmp/x {{P}}",
      "python3 -c \"open('{{P}}','w').write('x')\"",
      "node -e \"require('fs').writeFileSync('{{P}}','x')\""
    ],
    "read": [
      "cat {{P}}",
      "head -n 5 {{P}}",
      "grep . {{P}}",
      "base64 < {{P}}",
      "source {{P}}",
      "cp {{P}} /tmp/y",
      "tail -n 1 {{P}}",
      "awk 1 {{P}}",
      "sort {{P}}"
    ],
    "wrapped": [
      "bash -c 'cat {{P}}'",
      "sh -c \"echo x > {{P}}\"",
      "(cat {{P}})",
      "echo $(cat {{P}})",
      "echo `cat {{P}}`",
      "eval \"cat {{P}}\"",
      "env A=1 cat {{P}}",
      "F={{P}}; cat \"$F\"",
      "shopt -s expand_aliases 2>/dev/null; alias c=cat; eval \"c {{P}}\"",
      "echo {{P}} | xargs cat",
      "cat <<'EOF' > {{P}}\nx\nEOF",
      "true && cat {{P}}"
    ]
  },
  "refuse_folder": [
    "grep -r . {{DIR}}",
    "find {{DIR}} -type f -exec cat {} +",
    "ls -A {{DIR}} | sed 's|^|{{DIR}}/|' | xargs cat",
    "cat {{DIR}}/* {{DIR}}/.* 2>/dev/null",
    "rm -rf {{DIR}}"
  ],
  "refuse_after_cd": [
    "cd {{DIR}} && cat {{BASE}}",
    "cd {{DIR}}; echo x > {{BASE}}",
    "(cd {{DIR}} && cat {{BASE}})",
    "pushd {{DIR}} >/dev/null && cat {{BASE}}"
  ],
  "refuse_cd_up": [
    "cd .. && cat {{UP}}/{{BASE}}",
    "cd ..; echo x > {{UP}}/{{BASE}}"
  ],
  "dead": {
    "cp /tmp/x {{P}}": [
      "brace"
    ],
    "mv /tmp/x {{P}}": [
      "brace"
    ],
    "dd if=/tmp/x of={{P}}": [
      "glob",
      "qmark",
      "lead-qmarks",
      "bracket",
      "early-bracket",
      "brace"
    ],
    "ln -sf /tmp/x {{P}}": [
      "brace"
    ],
    "python3 -c \"open('{{P}}','w').write('x')\"": [
      "backslash",
      "glob",
      "qmark",
      "lead-qmarks",
      "bracket",
      "early-bracket",
      "ansi-c",
      "brace"
    ],
    "node -e \"require('fs').writeFileSync('{{P}}','x')\"": [
      "empty-quotes",
      "early-quotes",
      "late-quotes",
      "glob",
      "qmark",
      "lead-qmarks",
      "bracket",
      "early-bracket",
      "ansi-c",
      "brace"
    ],
    "base64 < {{P}}": [
      "brace"
    ],
    "cp {{P}} /tmp/y": [
      "brace"
    ],
    "sort {{P}}": [
      "brace"
    ],
    "bash -c 'cat {{P}}'": [
      "hex-printf",
      "octal-printf",
      "ansi-c"
    ],
    "sh -c \"echo x > {{P}}\"": [
      "glob",
      "qmark",
      "lead-qmarks",
      "bracket",
      "early-bracket",
      "brace"
    ],
    "F={{P}}; cat \"$F\"": [
      "glob",
      "qmark",
      "lead-qmarks",
      "bracket",
      "early-bracket",
      "brace"
    ]
  },
  "allow": [
    "ls",
    "git status",
    "node --test",
    "cat README.md",
    "echo hello > /tmp/scratch.txt",
    "git commit -m \"fix the typo\"",
    "ls *.md",
    "echo $HOME",
    "cat ./README.md",
    "grep -r 'TODO' src",
    "cd src && ls ../docs",
    "printf '%s\\n' done",
    "printf '\\x41\\n'",
    "printf '\\101\\n'",
    "echo aGk= | base64 -d",
    "git diff --stat"
  ],
  "allow_near": [
    "ls {{DIR}}",
    "cd {{DIR}} && ls",
    "cat {{DIR}}/README.md",
    "cat {{WORD}}-notes.md",
    "grep -rn {{WORD}} docs"
  ],
  "allow_elsewhere": [
    "ls",
    "cat README.md",
    "git status"
  ]
}
